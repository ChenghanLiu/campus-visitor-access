{"remainingRequest":"/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/src/views/index.vue?vue&type=style&index=0&id=a83bd3b0&scoped=true&lang=css","dependencies":[{"path":"/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/src/views/index.vue","mtime":1772567875991},{"path":"/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/node_modules/css-loader/dist/cjs.js","mtime":1772526780733},{"path":"/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1772526788107},{"path":"/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/node_modules/postcss-loader/src/index.js","mtime":1772526790914},{"path":"/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/node_modules/cache-loader/dist/cjs.js","mtime":1772526784800},{"path":"/Users/liuchenghan/Desktop/campus-visitor-access/front/admin/node_modules/vue-loader/lib/index.js","mtime":1772526788104}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:DQoubGF5b3V0IHsNCiAgaGVpZ2h0OiAxMDAlOw0KfQ0KDQouaGVhZGVyLXJpZ2h0IHsNCiAgZmxvYXQ6IHJpZ2h0Ow0KICBmb250LXdlaWdodDogNTAwOw0KfQ0K"},{"version":3,"sources":["index.vue"],"names":[],"mappings":";AAqGA;AACA;AACA;;AAEA;AACA;AACA;AACA","file":"index.vue","sourceRoot":"src/views","sourcesContent":["\r\n\r\n<template>\r\n  <div class=\"layout\">\r\n    <el-container style=\"height: 100vh\">\r\n\r\n      <!-- 左侧菜单 -->\r\n      <el-aside width=\"220px\">\r\n        <el-menu\r\n            :default-active=\"$route.path\"\r\n            class=\"el-menu-vertical-demo\"\r\n            router\r\n        >\r\n\r\n          <el-menu-item index=\"/\">\r\n            系统首页\r\n          </el-menu-item>\r\n\r\n          <el-menu-item index=\"/users\" v-if=\"isAdmin\">用户管理</el-menu-item>\r\n\r\n          <el-menu-item index=\"/labs\">\r\n            楼栋信息\r\n          </el-menu-item>\r\n\r\n\r\n\r\n\r\n          <el-menu-item index=\"/reservations\">\r\n            预约管理\r\n          </el-menu-item>\r\n\r\n\r\n\r\n          <el-menu-item index=\"/analytics\" v-if=\"isAdmin\">统计分析</el-menu-item>\r\n\r\n          <el-menu-item @click=\"logout\">\r\n            退出登录\r\n          </el-menu-item>\r\n\r\n        </el-menu>\r\n      </el-aside>\r\n\r\n      <!-- 主体 -->\r\n      <el-container>\r\n        <el-header style=\"background: #fff;\">\r\n          <div class=\"header-right\">\r\n            高校宿舍访客预约管理系统\r\n          </div>\r\n        </el-header>\r\n\r\n        <el-main style=\"background: #f5f7fa;\">\r\n          <router-view />\r\n        </el-main>\r\n      </el-container>\r\n\r\n    </el-container>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\n\r\nexport default {\r\n  name: \"Layout\",\r\n\r\n  data() {\r\n    return {\r\n      role: (localStorage.getItem(\"Role\") || \"\").trim().toUpperCase()\r\n    };\r\n  },\r\n\r\n  computed: {\r\n    isAdmin() {\r\n      return this.role === \"ADMIN\";\r\n    }\r\n  },\r\n\r\n  created() {\r\n    // 进入 Layout 时重新读一次，确保登录跳转后菜单立即正确\r\n    this.role = (localStorage.getItem(\"Role\") || \"\").trim().toUpperCase();\r\n  },\r\n\r\n  watch: {\r\n    // 每次路由变化都刷新一次 role（解决“登录后不刷新”的核心问题）\r\n    $route() {\r\n      this.role = (localStorage.getItem(\"Role\") || \"\").trim().toUpperCase();\r\n    }\r\n  },\r\n\r\n  methods: {\r\n    logout() {\r\n      localStorage.removeItem(\"Token\");\r\n      localStorage.removeItem(\"Role\");\r\n      this.$router.replace({ name: \"login\" });\r\n    }\r\n  }\r\n};\r\n\r\n\r\n</script>\r\n\r\n<style scoped>\r\n.layout {\r\n  height: 100%;\r\n}\r\n\r\n.header-right {\r\n  float: right;\r\n  font-weight: 500;\r\n}\r\n</style>\r\n"]}]}